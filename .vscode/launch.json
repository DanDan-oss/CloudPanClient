{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "(gdb) Attach to fdfs_client",
            "type": "cppdbg",
            "request": "attach",
            "program": "${workspaceFolder}/code/http_server/fdfs_client/bin/fdfs_client.exe",
            "processId": "${command:pickProcess}",
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "miDebuggerServerAddress": "127.0.0.1:2345",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "(gdb) Attach to fdfs_register",
            "type": "cppdbg",
            "request": "attach",
            "program": "${workspaceFolder}/code/http_server/fdfs_register/bin/fdfs_register.exe",
            "processId": "${command:pickProcess}",
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "miDebuggerServerAddress": "127.0.0.1:2346",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "(gdb) Attach to file_upload",
            "type": "cppdbg",
            "request": "attach",
            "program": "${workspaceFolder}/code/http_server/file_upload/bin/file_upload.exe",
            "processId": "${command:pickProcess}",
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "miDebuggerServerAddress": "127.0.0.1:2347",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}"
        }
    ]
}